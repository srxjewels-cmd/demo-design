# ── Meta / Instagram (Path A) ────────────────────────────────────────────────
META_PAGE_TOKEN=            # Page access token from your Meta app
META_APP_SECRET=            # App secret (used to verify X-Hub-Signature-256)
META_VERIFY_TOKEN=          # Any random string; paste the same value in the Meta webhook config
META_GRAPH_VERSION=v21.0

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── CRM / Store ──────────────────────────────────────────────────────────────
APOLLO_API_KEY=             # optional until M3 — leave blank to skip Apollo lookups
SHOPIFY_TOKEN=              # Admin API access token (shpat_...)
SHOPIFY_STORE=              # store subdomain only, e.g. "mystore" for mystore.myshopify.com

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=         # single-user login password
SESSION_SECRET=             # long random string; used to sign the session cookie

# ── Web Push (generate with: python -m app.genkeys) ──────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com

# ── Misc ─────────────────────────────────────────────────────────────────────
DB_PATH=data/assistant.db
SENSITIVE_REFUND_THRESHOLD=100   # flag drafts when refund amounts above this appear
